<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS Emergency Dispatch Permission -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service & Notification Permissions for Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Needed on Android 12+ to schedule exact alarms for timer check-in -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Required to show PIN challenge activity over lock screen -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Life Guard"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- Google Maps API Key (injected from gradle / local.properties) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Route Import from Google Maps Share Sheet -->
        <activity
            android:name=".route.RouteImportActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Timer Check-In PIN challenge — launched over lock screen -->
        <activity
            android:name=".timer.TimerCheckInActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTop" />

        <!-- Route Deviation PIN challenge — launched when off-route -->
        <activity
            android:name=".route.RouteDeviationActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTop" />

        <!-- Alarm receiver for timer check-in -->
        <receiver
            android:name=".timer.TimerCheckInReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lifeguard.app.ACTION_TIMER_CHECKIN" />
            </intent-filter>
        </receiver>

        <!-- Location Foreground Service -->
        <service
            android:name=".service.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Route Deviation Monitoring Service -->
        <service
            android:name=".route.RouteDeviationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM Push Notification Service -->
        <service
            android:name=".fcm.LifeGuardFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Navigate-to-Victim transparent activity (launched from notification) -->
        <activity
            android:name=".fcm.NavigateToVictimActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTop" />

    </application>

</manifest>
